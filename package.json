{
  "name": "online-voting-system",
  "version": "2.0.0",
  "description": "Online voting system with OTP-verified registration, one-ballot-per-voter enforcement, and a voting officer dashboard.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "seed:officer": "node src/scripts/createOfficer.js",
    "test": "node --test test/*.test.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:demo": "npm --prefix client run build:demo"
  },
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3"
  },
  "engines": {
    "node": ">=18"
  }
}
